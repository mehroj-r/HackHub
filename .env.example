# Copy to .env and fill in. .env is never committed.
# See docs/04-setup-and-deployment.md > Configuration.

# Prisma connection string. Host and port must match docker-compose.yml.
DATABASE_URL="postgresql://hackhub:hackhub@localhost:5432/hackhub"

# Signs Auth.js sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Public URL of the app. https://<domain> in production.
AUTH_URL="http://localhost:3000"

# Credentials for the Postgres container in docker-compose.yml.
# Keep them in step with DATABASE_URL. Use real secrets in production.
POSTGRES_USER=hackhub
POSTGRES_PASSWORD=hackhub
POSTGRES_DB=hackhub

# The first organizer, created by `npx prisma db seed` (docs/07 > Seed).
# Required everywhere. The seed fails if either is missing or the password
# is under 8 characters. Re-running it never changes an existing password.
SEED_ORGANIZER_EMAIL="organizer@example.com"
SEED_ORGANIZER_PASSWORD="replace-me-please"

# Production only (docker-compose.prod.yml): the host port the app is published
# on (127.0.0.1 only), and Auth.js trusting the host's nginx proxy headers.
# APP_PORT=3120
# AUTH_TRUST_HOST=true

# Local and CI only, never production: the seed also creates
# judge@hackhub.test and participant1..3@hackhub.test with this password.
# SEED_DEMO_USERS=true
# SEED_DEMO_PASSWORD="replace-me-please"
